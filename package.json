{
  "name": "@mathieuc/tradingview",
  "version": "4.1.0",
  "description": "TradingView market data for JavaScript and TypeScript: candles, quotes, indicators and strategies, with a simple data API and full low-level access.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./backtest": {
      "types": "./dist/backtest/index.d.ts",
      "import": "./dist/backtest/index.js",
      "default": "./dist/backtest/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "scripts/endurance.mjs",
    "scripts/probe-account.mjs",
    "assets",
    "!assets/readme-film*.webp",
    "llms.txt",
    "examples",
    "scripts/parity.mjs",
    "bin"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:bun": "bun test tests/unit",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
    "prepack": "npm run build",
    "probe:endurance": "npm run build && node scripts/endurance.mjs",
    "probe:parity": "npm run build && node scripts/parity.mjs",
    "probe:account": "npm run build && node scripts/probe-account.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mathieu2301/TradingView-API.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "tradingview",
    "market-data",
    "candles",
    "quotes",
    "stocks",
    "crypto",
    "forex",
    "backtest",
    "indicator",
    "pine",
    "websocket",
    "api"
  ],
  "author": "Mathieu Colmon",
  "license": "ISC",
  "dependencies": {
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/Mathieu2301/TradingView-API#readme",
  "bugs": {
    "url": "https://github.com/Mathieu2301/TradingView-API/issues"
  },
  "bin": {
    "tradingview": "bin/tradingview.mjs"
  }
}
